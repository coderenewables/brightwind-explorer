 {
  "path": "wk.get_cross_predictions",
  "group": "Wind climates",
  "inputs": {
   "wcs": [
    "BWC",
    "WWC"
   ],
   "wcs_src": [
    "BWC",
    "WWC"
   ]
  },
  "outputs": [
   {
    "name": "from_locs",
    "types": [
     "BWC",
     "WWC"
    ],
    "same": "wcs"
   },
   {
    "name": "to_locs",
    "types": [
     "BWC",
     "WWC"
    ],
    "same": "wcs"
   }
  ],
  "tuple": true,
  "fields": {
   "include_self_predictions": {
    "mode": "bool"
   },
   "only_upward_extrapolations": {
    "mode": "bool"
   }
  },
  "browser": "ok",
  "note": "Can raise an InvalidIndexError on some multi-height inputs, where windkit creates duplicate target points.",
  "probe": [
   {
    "args": {
     "wcs": "wk.bwc_from_tswc(wk.create_tswc(S['StackedPoint'], date_range=pd.date_range('2020-01-01', periods=24 * 60, freq='h')))",
     "include_self_predictions": "False"
    }
   },
   {
    "args": {
     "wcs": "@WWC"
    }
   }
  ]
 },
