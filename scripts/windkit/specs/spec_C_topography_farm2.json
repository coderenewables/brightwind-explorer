    }
   }
  ]
 },
 {
  "path": "wk.polygons_to_lines",
  "group": "Topography",
  "inputs": {
   "gdf": [
    "GeoDataFrame"
   ],
   "lctable": [
    "LandCoverTable"
   ]
  },
  "outputs": [
   {
    "name": "lines",
    "types": [
     "VectorMap"
    ]
   },
   {
    "name": "lctable",
    "types": [
     "Dict"
    ],
    "flag": "return_lctable"
   }
  ],
  "order": [
   "lines",
   "lctable"
  ],
  "fields": {
   "map_type": {
    "mode": "choice",
    "choices": [
     "roughness",
     "landcover"
    ]
   }
  },
  "browser": "ok",
  "note": "The landcover table comes back as a plain dict, not a LandCoverTable object.",
  "probe": [
   {
    "args": {
     "gdf": "wk.lines_to_polygons(S['VectorMap_roughness'])",
     "lctable": "@LandCoverTable"
    }
   },
   {
    "args": {
     "gdf": "wk.lines_to_polygons(S['VectorMap_roughness']).assign(z0=0.03, d=0.0)",
     "lctable": "@LandCoverTable",
     "map_type": "'landcover'",
     "return_lctable": "True"
    }
   }
  ]
 },
 {
  "path": "wk.roughness_to_landcover",
