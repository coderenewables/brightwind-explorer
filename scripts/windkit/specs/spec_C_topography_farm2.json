[
 {
  "path": "wk.landcover_to_roughness",
  "group": "Topography",
  "inputs": {
   "lc": [
    "RasterMap",
    "VectorMap"
   ],
   "lctable": [
    "LandCoverTable"
   ]
  },
  "outputs": [
   {
    "name": "map",
    "types": [
     "RasterMap",
     "VectorMap"
    ],
    "same": "lc"
   }
  ],
  "fields": {},
  "browser": "ok",
  "note": "",
  "probe": [
   {
    "args": {
     "lc": "@RasterMap_landcover",
     "lctable": "@LandCoverTable"
    }
   },
   {
    "args": {
     "lc": "wk.roughness_to_landcover(S['VectorMap_roughness'])[0]",
     "lctable": "wk.roughness_to_landcover(S['VectorMap_roughness'])[1]"
    }
   }
  ]
 },
