 {
  "path": "wk.load_tutorial_data",
  "group": "Data download",
  "inputs": {},
  "outputs": [
   {
    "name": "bwc",
    "types": [
     "BWC"
    ]
   },
   {
    "name": "wtg",
    "types": [
     "WTG"
    ]
   },
   {
    "name": "turbines",
    "types": [
     "WindTurbines"
    ]
   },
   {
    "name": "elev",
    "types": [
     "VectorMap"
    ]
   },
   {
    "name": "rgh",
    "types": [
     "VectorMap"
    ]
   }
  ],
  "fields": {
   "name": {
    "mode": "choice",
    "choices": [
     "serra_santa_luzia"
    ]
   }
  },
  "browser": "ok",
  "note": "Downloads the Serra Santa Luzia example (4.6 MB, a 15-turbine site in Portugal) from Zenodo and loads its wind climate, turbine, layout and maps.",
  "attrs": true,
  "var": "tutorial",
  "setup": "import offline; offline.fake_zenodo(wk, S, TMP)",
  "probe": [
   {
    "args": {
     "name": "'serra_santa_luzia'"
    }
   }
  ]
 },
 {
  "path": "wk.loss_table_summary",
  "group": "Wind farm",
  "inputs": {
   "loss_table": [
    "LossTable"
   ]
  },
  "outputs": [],
  "fields": {},
  "browser": "ok",
  "note": "",
  "probe": [
   {
    "args": {
