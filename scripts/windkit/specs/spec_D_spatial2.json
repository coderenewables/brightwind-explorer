[
 {
  "path": "wk.spatial.get_spatial_struct",
  "group": "Spatial",
  "inputs": {
   "obj": [
    "Dataset",
    "DataArray"
   ]
  },
  "outputs": [
   {
    "name": "structure",
    "types": [
     "Value"
    ]
   }
  ],
  "fields": {},
  "browser": "ok",
  "note": "Returns the structure name as text, or None when the object has no spatial structure.",
  "probe": [
   {
    "args": {
     "obj": "@Point"
    }
   },
   {
    "args": {
     "obj": "@Raster"
    }
   }
  ]
 },
 {
  "path": "wk.spatial.grid_convergence",
  "group": "Spatial",
  "inputs": {
   "ds": [
    "Dataset",
    "DataArray"
   ],
   "source": [
    "Dataset",
    "DataArray",
    "GeoDataFrame",
    "BBox"
   ]
  },
  "outputs": [
   {
    "name": "convergence",
    "types": [
     "DataArray"
    ]
   }
  ],
  "fields": {},
  "browser": "ok",
  "note": "Leave source empty to get grid convergence relative to the grid's own north.",
  "probe": [
   {
    "args": {
     "ds": "@Point"
    }
   },
   {
    "args": {
     "ds": "@Point",
     "source": "@GeoDataFrame"
    }
   },
   {
    "args": {
     "ds": "@Raster",
     "source": "@BBox"
    }
   }
  ]
 },
 {
  "path": "wk.spatial.interp_structured_like",
  "group": "Spatial",
  "inputs": {
   "source": [
    "Dataset",
    "DataArray"
   ],
   "target": [
    "Dataset",
    "DataArray"
   ]
  },
  "outputs": [
   {
    "name": "interpolated",
    "types": [
     "Dataset",
     "DataArray"
    ],
    "same": "target"
   }
  ],
  "fields": {},
  "browser": "ok",
  "note": "Source must be a cuboid; the result takes the spatial structure of the target.",
  "probe": [
   {
    "args": {
     "source": "@Cuboid",
     "target": "@StackedPoint"
    }
   },
   {
    "args": {
     "source": "@Cuboid",
     "target": "@Point"
    }
   }
  ]
 },
 {
  "path": "wk.spatial.interp_unstructured",
  "group": "Spatial",
  "inputs": {
   "obj": [
    "Dataset",
    "DataArray"
   ],
   "west_east": [
    "DataArray"
   ],
   "south_north": [
    "DataArray"
   ],
   "height": [
    "DataArray"
   ]
  },
  "outputs": [
   {
    "name": "interpolated",
    "types": [
     "Dataset",
     "DataArray"
    ],
    "same": "obj"
   }
  ],
  "fields": {
   "method": {
    "mode": "choice",
    "choices": [
     "nearest",
     "linear",
     "cubic",
     "natural",
     "rbf"
    ]
   }
  },
  "browser": "ok",
  "note": "Interpolates to the coordinates given by the west_east, south_north and height inputs.",
  "probe": [
   {
    "args": {
     "obj": "@Cuboid",
     "west_east": "S['StackedPoint']['west_east']",
     "south_north": "S['StackedPoint']['south_north']",
     "height": "S['StackedPoint']['height']"
    }
   },
   {
    "args": {
     "obj": "@Cuboid",
     "west_east": "S['StackedPoint']['west_east']",
     "south_north": "S['StackedPoint']['south_north']",
     "height": "S['StackedPoint']['height']",
     "method": "'nearest'"
    }
   }
  ]
 },
