 {
  "path": "wk.spatial.mask",
  "group": "Spatial",
  "inputs": {
   "obj": [
    "Dataset",
    "DataArray"
   ],
   "mask": [
    "GeoDataFrame",
    "BBox"
   ]
  },
  "outputs": [
   {
    "name": "masked",
    "types": [
     "Dataset",
     "DataArray"
    ],
    "same": "obj"
   }
  ],
  "fields": {},
  "browser": "ok",
  "note": "Values outside the mask are set to NaN unless invert is on.",
  "probe": [
   {
    "args": {
     "obj": "@Raster",
     "mask": "@BBox"
    }
   },
   {
    "args": {
     "obj": "@Raster",
     "mask": "__import__('geopandas').GeoDataFrame({'geometry': [__import__('shapely').geometry.box(500000, 5900000, 500250, 5900250)]}, crs='EPSG:32629')"
    }
   }
  ]
 },
 {
  "path": "wk.spatial.nearest_points",
  "group": "Spatial",
  "inputs": {
   "ds_ref": [
    "Dataset"
   ],
   "ds_target": [
    "Dataset"
   ]
  },
  "outputs": [
   {
    "name": "nearest",
    "types": [
     "Dataset"
    ],
    "same": "ds_target"
   }
  ],
  "fields": {},
  "browser": "ok",
  "note": "For each target location, selects the nearest source location(s); more than one nearest point needs a point target.",
  "probe": [
   {
    "args": {
     "ds_ref": "@Cuboid",
     "ds_target": "@StackedPoint"
    }
   },
   {
    "args": {
     "ds_ref": "@Cuboid",
     "ds_target": "@Point",
     "n_nearest": "2",
     "return_distance": "True"
    }
   }
  ]
 },
 {
  "path": "wk.spatial.reproject",
  "group": "Spatial",
  "inputs": {
   "obj": [
    "GeoDataFrame",
    "DataArray",
    "Dataset",
    "BBox"
   ]
  },
  "outputs": [
   {
    "name": "reprojected",
    "types": [
     "GeoDataFrame",
     "DataArray",
     "Dataset",
     "BBox"
    ],
    "same": "obj"
   }
  ],
  "fields": {
   "to_crs": {
    "mode": "text"
   }
  },
  "browser": "ok",
  "note": "Changes the coordinate system of the data; the values are not changed.",
  "probe": [
   {
    "args": {
     "obj": "@Point",
     "to_crs": "'EPSG:4326'"
    }
   },
   {
    "args": {
     "obj": "@DataArray",
     "to_crs": "'EPSG:4326'"
    }
   },
   {
    "args": {
     "obj": "@BBox",
     "to_crs": "'EPSG:4326'"
    }
   },
   {
    "args": {
     "obj": "@GeoDataFrame",
     "to_crs": "'EPSG:4326'"
    }
   }
  ]
 },
 {
  "path": "wk.spatial.set_crs",
  "group": "Spatial",
  "inputs": {
   "obj": [
    "GeoDataFrame",
    "DataArray",
    "Dataset",
    "BBox"
   ]
  },
  "outputs": [
   {
    "name": "with_crs",
    "types": [
     "GeoDataFrame",
     "DataArray",
     "Dataset",
     "BBox"
    ],
    "same": "obj"
   }
  ],
  "fields": {
   "crs": {
    "mode": "text"
   }
  },
  "browser": "ok",
  "note": "Assigns a coordinate system without moving any coordinates.",
  "probe": [
   {
    "args": {
     "obj": "@Point",
     "crs": "'EPSG:32629'"
    }
   },
   {
    "args": {
     "obj": "@BBox",
     "crs": "'EPSG:4326'"
    }
   },
   {
    "args": {
     "obj": "@GeoDataFrame",
     "crs": "'EPSG:4326'"
    }
   }
  ]
 },
 {
  "path": "wk.spatial.to_cuboid",
  "group": "Spatial",
  "inputs": {
   "obj": [
    "Dataset",
    "DataArray"
   ]
  },
  "outputs": [
   {
    "name": "cuboid",
    "types": [
     "Cuboid",
     "Raster",
     "DataArray"
    ]
   }
  ],
  "fields": {},
  "browser": "ok",
  "note": "Same conversion as to_raster: needs grid-like data, or ignore_raster_check on for point data.",
  "probe": [
   {
    "args": {
     "obj": "@Raster"
    }
   },
   {
    "args": {
     "obj": "@Point",
     "ignore_raster_check": "True"
    }
   },
   {
    "args": {
     "obj": "@StackedPoint",
     "ignore_raster_check": "True"
    }
   }
  ]
 },
