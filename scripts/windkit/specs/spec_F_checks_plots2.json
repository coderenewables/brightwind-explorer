 {
  "path": "wk.plot.roughness_rose",
  "group": "Plots",
  "inputs": {
   "ds": [
    "Dataset"
   ]
  },
  "outputs": [
   {
    "name": "figure",
    "types": [
     "Plotly"
    ]
   }
  ],
  "fields": {
   "style": {
    "mode": "choice",
    "choices": [
     "rose",
     "bar"
    ]
   }
  },
  "browser": "plotly",
  "note": "Takes one point's roughness rose dataset (sector, roughness-change dimensions, z0, dist, nrch).",
  "probe": [
   {
    "args": {
     "ds": "xr.Dataset({'z0': (('point', 'sector', 'max_rou_changes1'), np.full((1, 12, 3), 0.03), {'long_name': 'Roughness length', 'units': 'm'}), 'dist': (('point', 'sector', 'max_rou_changes'), np.full((1, 12, 2), 1000.0), {'long_name': 'Distance to roughness change', 'units': 'm'}), 'nrch': (('point', 'sector'), np.full((1, 12), 2))}, coords={'west_east': ('point', [500000.0], {'long_name': 'West-east', 'units': 'm'}), 'south_north': ('point', [5900000.0], {'long_name': 'South-north', 'units': 'm'}), 'sector': ('sector', np.arange(12), {'long_name': 'Sector', 'units': '-'})})"
    }
   },
   {
    "args": {
     "ds": "xr.Dataset({'z0': (('point', 'sector', 'max_rou_changes1'), np.full((1, 12, 3), 0.03), {'long_name': 'Roughness length', 'units': 'm'}), 'dist': (('point', 'sector', 'max_rou_changes'), np.full((1, 12, 2), 1000.0), {'long_name': 'Distance to roughness change', 'units': 'm'}), 'nrch': (('point', 'sector'), np.full((1, 12), 2))}, coords={'west_east': ('point', [500000.0], {'long_name': 'West-east', 'units': 'm'}), 'south_north': ('point', [5900000.0], {'long_name': 'South-north', 'units': 'm'}), 'sector': ('sector', np.arange(12), {'long_name': 'Sector', 'units': '-'})})",
     "style": "'bar'"
    }
   }
  ]
 },
