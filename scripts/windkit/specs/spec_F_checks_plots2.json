  "path": "wk.plot.time_series",
  "group": "Plots",
  "inputs": {
   "ds": [
    "TSWC",
    "DataArray"
   ]
  },
  "outputs": [
   {
    "name": "figure",
    "types": [
     "Plotly"
    ]
   }
  ],
  "fields": {},
  "browser": "plotly",
  "note": "The time coordinate needs long_name and units attributes to be plotted.",
  "probe": [
   {
    "args": {
     "ds": "S['TSWC'].assign_coords(time=S['TSWC'].time.assign_attrs(long_name='Time', units='hours since 2020-01-01'))"
    }
   },
   {
    "args": {
     "ds": "S['TSWC'].assign_coords(time=S['TSWC'].time.assign_attrs(long_name='Time', units='hours since 2020-01-01'))['wind_speed']"
    }
   }
  ]
 },
